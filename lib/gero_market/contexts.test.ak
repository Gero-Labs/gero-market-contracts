//// Pins the script contexts that `scripts/eval-applied.mjs` runs through the applied scripts.
////
//// Each test serialises one context of `contexts.ak` and compares it with the bytes of
//// `test-vectors/contexts/<deployment>/<name>.hex`, written out here in full. A test is named
//// `<deployment>_<name>`, with the dash of the deployment folder as an underscore, and
//// `scripts/eval-applied.mjs` refuses a context file whose bytes are not the ones its test pins. A
//// change to a context therefore fails here until the file and the bytes below change together.
////
//// To add a context or a deployment: write its test with `#""`, run
//// `aiken check -m gero_market/contexts`, and copy the bytes Aiken reports into the test and into
//// the file.

use aiken/cbor
use gero_market/contexts.{
  cancel_bad_datum_context, cancel_constr_datum_context,
  cancel_constr_datum_unsigned_context, cancel_no_datum_context, cancel_ok,
  context, preprod_v1, purchase_constr_datum_context, purchase_fee_short,
  purchase_no_royalty, purchase_ok, purchase_three_royalties,
}

test preprod_v1_purchase_ok() {
  cbor.serialise(context(purchase_ok(preprod_v1))) == #""
}

test preprod_v1_purchase_no_royalty() {
  cbor.serialise(context(purchase_no_royalty(preprod_v1))) == #""
}

test preprod_v1_purchase_three_royalties() {
  cbor.serialise(context(purchase_three_royalties(preprod_v1))) == #""
}

test preprod_v1_purchase_fee_short() {
  cbor.serialise(context(purchase_fee_short(preprod_v1))) == #""
}

test preprod_v1_cancel_ok() {
  cbor.serialise(context(cancel_ok(preprod_v1))) == #""
}

test preprod_v1_cancel_no_datum() {
  cbor.serialise(cancel_no_datum_context(preprod_v1)) == #""
}

test preprod_v1_cancel_bad_datum() {
  cbor.serialise(cancel_bad_datum_context(preprod_v1)) == #""
}

test preprod_v1_cancel_constr_datum() {
  cbor.serialise(cancel_constr_datum_context(preprod_v1)) == #""
}

test preprod_v1_cancel_constr_datum_unsigned() {
  cbor.serialise(cancel_constr_datum_unsigned_context(preprod_v1)) == #""
}

test preprod_v1_purchase_constr_datum() {
  cbor.serialise(purchase_constr_datum_context(preprod_v1)) == #""
}
